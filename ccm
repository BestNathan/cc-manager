#!/usr/bin/env bash
# cc-manager — 管理多个 Claude Code 环境
set -o pipefail

CCM_VERSION="0.1.0"
CCM_HOME="${CCM_HOME:-$HOME/.cc-manager}"
PROFILES_DIR="$CCM_HOME/profiles"
TEMPLATE="$CCM_HOME/template.env"

# ─── Color: tput (portable), auto-detect terminal ────────────────────
_cc_on=0
if [ -t 2 ] 2>/dev/null; then
  # Try tput; fall back to raw ANSI if tput unavailable
  if command -v tput >/dev/null 2>&1 && tput sgr0 >/dev/null 2>&1; then
    _cc_on=1
    _cc_BOLD="$(tput bold)"
    _cc_CYAN="$(tput setaf 6)"
    _cc_GREEN="$(tput setaf 2)"
    _cc_YELLOW="$(tput setaf 3)"
    _cc_RED="$(tput setaf 1)"
    _cc_DIM="$(tput setaf 8)"
    _cc_RESET="$(tput sgr0)"
  else
    _cc_on=1
    _cc_BOLD=$'\033[1m'; _cc_CYAN=$'\033[36m'; _cc_GREEN=$'\033[32m'
    _cc_YELLOW=$'\033[33m'; _cc_RED=$'\033[31m'; _cc_DIM=$'\033[2m'
    _cc_RESET=$'\033[0m'
  fi
fi

_cc() { # _cc <var_name> <text...>  → wraps text in color var
  local vname="$1"; shift
  if [ "$_cc_on" -eq 1 ]; then
    printf '%s%s%s' "${!vname}" "$*" "$_cc_RESET"
  else
    printf '%s' "$*"
  fi
}
# Compatibility wrappers — old _cc_X() names → new _cc() + tput var
_cc_b()  { _cc _cc_BOLD  "$@"; }
_cc_c()  { _cc _cc_CYAN   "$@"; }
_cc_g()  { _cc _cc_GREEN  "$@"; }
_cc_y()  { _cc _cc_YELLOW "$@"; }
_cc_r()  { _cc _cc_RED    "$@"; }
_cc_d()  { _cc _cc_DIM    "$@"; }
_cc_bg() { _cc _cc_BOLD  "$@"; }
_cc_br() { _cc _cc_RED   "$@"; }
_cc_bc() { _cc _cc_BOLD  "$@"; }

_die() { # _die <code> <msg...>
  local code="$1"; shift
  printf 'cc-manager: %s\n' "$*" >&2
  exit "$code"
}

_ensure_skeleton() {
  mkdir -p "$PROFILES_DIR"
  if [ ! -f "$TEMPLATE" ]; then
    cat >"$TEMPLATE" <<'EOF'
# cc-manager profile — 占位符,请替换为真实值后使用
# 启动: ccm run <本文件名去掉 .env>

export ANTHROPIC_AUTH_TOKEN="<YOUR_TOKEN_HERE>"
export ANTHROPIC_BASE_URL="<https://your-gateway.example.com>"

# 模型映射(按需修改)
# _NAME 变量仅在与 _MODEL 值不同时才需要设置(用于自定义显示名称)
export ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-4-8"
# export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="claude-opus-4-8"
export ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-4-6"
# export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME="claude-sonnet-4-6"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="claude-haiku-4-5-20251001"
# export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME="claude-haiku-4-5-20251001"

# 可选:子代理模型
# export CLAUDE_CODE_SUBAGENT_MODEL="<model-id>"
EOF
  fi
}

_profile_path() {
  case "$1" in
    ""|*/*|*..*) _die 2 "非法 profile 名: '$1'(不能为空或含 / 或 ..)" ;;
  esac
  printf '%s/%s.env' "$PROFILES_DIR" "$1"
}

_check_settings_anthropic() {
  local file="$1"
  [ -f "$file" ] || return
  local keys
  if command -v jq >/dev/null 2>&1; then
    keys="$(jq -r '.env // {} | keys[]' "$file" 2>/dev/null | grep '^ANTHROPIC_')" || return
    [ -z "$keys" ] && return
    local k val
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      val="$(jq -r ".env[\"$k\"] // \"\"" "$file" 2>/dev/null)"
      [ -n "$val" ] && printf '  %s="%s"\n' "$k" "$(_mask "$val")"
    done <<<"$keys"
  else
    # 无 jq 时退化为 grep: 捕获 "ANTHROPIC_" 字符串出现即告警
    keys="$(grep -o '"ANTHROPIC_[A-Z_]*"' "$file" 2>/dev/null | tr -d '"')" || return
    [ -z "$keys" ] && return
    local k val
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      val="$(grep -o "\"${k}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null | head -1 | sed 's/.*: *"//;s/"$//')"
      [ -n "$val" ] && printf '  %s="%s"\n' "$k" "$(_mask "$val")"
    done <<<"$keys"
  fi
}

_mask() { # _mask <secret> -> 头4***尾4(过短则全星)
  local s="$1" n=${#1}
  if [ "$n" -le 8 ]; then printf '****'; else printf '%s***%s' "${s:0:4}" "${s: -4}"; fi
}

# ─── Backup helpers ──────────────────────────────────────────────────

_BACKUP_MAX=5

_rotate_backups() { # _rotate_backups <file> — shift back.N down, save current as back.1
  local file="$1"
  [ -f "$file" ] || return 0

  # Remove oldest if at cap
  rm -f "${file}.back.${_BACKUP_MAX}"

  # Shift: back.4→back.5, back.3→back.4, ..., back.1→back.2
  local i=$((_BACKUP_MAX - 1))
  while [ "$i" -ge 1 ]; do
    if [ -f "${file}.back.${i}" ]; then
      mv "${file}.back.${i}" "${file}.back.$((i + 1))"
    fi
    i=$((i - 1))
  done

  # Current file → back.1
  cp -p "$file" "${file}.back.1"
}

_restore_backup() { # _restore_backup <file> <N> — restore back.N, roll current→back.1, back.1→back.2, ..., back.(N-1)→back.N
  local file="$1" n="$2"
  [ -f "$file" ] || _die 1 "profile 文件不存在: $file"
  [ -f "${file}.back.${n}" ] || _die 1 "备份 back.${n} 不存在"

  # Save current content for rollback
  local current_content
  current_content="$(cat "$file")"

  # Save the target backup content (will become new current file)
  local restore_content
  restore_content="$(cat "${file}.back.${n}")"

  # Shift: current → back.1, back.1 → back.2, ..., back.(N-1) → back.N
  # Work backwards from N-1 to 1 to avoid overwriting
  local i=$((n - 1))
  while [ "$i" -ge 1 ]; do
    if [ -f "${file}.back.${i}" ]; then
      mv "${file}.back.${i}" "${file}.back.$((i + 1))"
    fi
    i=$((i - 1))
  done

  # Current → back.1
  printf '%s\n' "$current_content" > "${file}.back.1"

  # Restore content → current file
  printf '%s\n' "$restore_content" > "$file"
  chmod 600 "$file"
}

_list_backups() { # _list_backups <file> <name> — list all backups with metadata
  local file="$1" name="$2"
  local found=0 i
  for i in $(seq 1 "$_BACKUP_MAX"); do
    [ -f "${file}.back.${i}" ] || continue
    found=1
    local size mtime base_url
    size="$(wc -c < "${file}.back.${i}" | tr -d ' ')"
    mtime="$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "${file}.back.${i}" 2>/dev/null || stat -c '%y' "${file}.back.${i}" 2>/dev/null | cut -d'.' -f1 | tr 'T' ' ')"
    base_url="$(grep -E '^[[:space:]]*export[[:space:]]+ANTHROPIC_BASE_URL=' "${file}.back.${i}" 2>/dev/null | head -1)"
    base_url="${base_url#*=}"
    base_url="${base_url%\"}"; base_url="${base_url#\"}"
    base_url="${base_url%\'}"; base_url="${base_url#\'}"
    printf '  [%s] back.%s  %s  (%s bytes)  %s\n' "$(_cc_c "$i")" "$i" "$(_cc_d "$mtime")" "$(_cc_d "$size")" "$(_cc_y "${base_url:-(no base_url)}")"
  done
  [ "$found" -eq 1 ]
}

# ─── Profile UI helpers ─────────────────────────────────────

_parse_env_value() { # _parse_env_value <file> <VAR_NAME> -> stdout value
  local file="$1" var="$2"
  local line
  line="$(sed -n "s/^[[:space:]]*export[[:space:]]*${var}=[\"']\{0,1\}\([^\"'#]*\)[\"']\{0,1\}$/\1/p" "$file" 2>/dev/null | head -1)"
  printf '%s' "$line"
}

_mask_preview() { # _mask_preview <value> -> short preview for display
  local s="$1" n=${#1}
  if [ "$n" -eq 0 ]; then printf '(空)'
  elif [ "$n" -le 40 ]; then printf '%s' "$s"
  else printf '%s…(%d chars)' "${s:0:16}" "$n"
  fi
}

_write_profile() { # _write_profile <file> <tok> <url> <opus> <opus_n> <sonnet> <sonnet_n> <haiku> <haiku_n> <subagent>
  local file="$1" tok="$2" url="$3"
  local opus="$4" opus_n="$5" sonnet="$6" sonnet_n="$7"
  local haiku="$8" haiku_n="$9" subagent="${10}"

  # Helper: quote a value for safe sourcing. Uses single quotes, escaping embedded single quotes.
  _qval() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

  {
    printf '# cc-manager profile\n'
    printf 'export ANTHROPIC_AUTH_TOKEN=%s\n' "$(_qval "$tok")"
    printf 'export ANTHROPIC_BASE_URL=%s\n' "$(_qval "$url")"
    printf '\n# 模型映射(按需修改)\n'
    printf 'export ANTHROPIC_DEFAULT_OPUS_MODEL=%s\n' "$(_qval "$opus")"
    if [ -n "$opus_n" ] && [ "$opus_n" != "$opus" ]; then
      printf 'export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME=%s\n' "$(_qval "$opus_n")"
    fi
    printf 'export ANTHROPIC_DEFAULT_SONNET_MODEL=%s\n' "$(_qval "$sonnet")"
    if [ -n "$sonnet_n" ] && [ "$sonnet_n" != "$sonnet" ]; then
      printf 'export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME=%s\n' "$(_qval "$sonnet_n")"
    fi
    printf 'export ANTHROPIC_DEFAULT_HAIKU_MODEL=%s\n' "$(_qval "$haiku")"
    if [ -n "$haiku_n" ] && [ "$haiku_n" != "$haiku" ]; then
      printf 'export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME=%s\n' "$(_qval "$haiku_n")"
    fi
    printf '\n# 可选:子代理模型\n'
    if [ -n "$subagent" ]; then
      printf 'export CLAUDE_CODE_SUBAGENT_MODEL=%s\n' "$(_qval "$subagent")"
    else
      printf '# export CLAUDE_CODE_SUBAGENT_MODEL="<model-id>"\n'
    fi

    # Append custom environment variables if any
    if [ "${#_CUSTOM_KEYS[@]}" -gt 0 ]; then
      printf '\n# 自定义环境变量\n'
      local i
      for i in "${!_CUSTOM_KEYS[@]}"; do
        printf 'export %s=%s\n' "${_CUSTOM_KEYS[$i]}" "$(_qval "${_CUSTOM_VALS[$i]}")"
      done
    fi
  } > "$file"
  chmod 600 "$file"
}

_ui_clear() { # _ui_clear — clear screen + cursor home (ANSI escape)
  printf '\033[2J\033[H' >&2
}

_has_gum() { # 渲染门:gum 可执行且未被禁用(不要求 TTY,gum style/format 输出 ANSI 到管道也可)
  [ -z "${CCM_NO_GUM:-}" ] && command -v gum >/dev/null 2>&1
}

_gum_interactive() { # 交互门:在渲染门基础上额外要求 /dev/tty 可用(gum input/confirm/filter 需要)
  _has_gum && { : < /dev/tty; } 2>/dev/null
}

_ui_input() { # _ui_input <label> <hint> <initial> -> 结果写 stdout
  local label="$1" hint="$2" initial="$3"
  if _gum_interactive; then
    local tmp; tmp="$(mktemp)" || return 1
    if gum input --header "$label" --header.foreground 6 \
         ${initial:+--value "$initial"} --placeholder "$hint" \
         < /dev/tty > "$tmp" 2>/dev/tty; then
      cat "$tmp"; rm -f "$tmp"; return 0
    fi
    rm -f "$tmp"; return 1
  fi
  local ans
  printf '  %s' "$(_cc_d "$label (回车保留 ${initial:-空}): ")" >&2
  IFS= read -r ans || return 1
  if [ -z "$ans" ]; then printf '%s\n' "$initial"; else printf '%s\n' "$ans"; fi
}

_ui_password() { # _ui_password <label> <hint> -> 结果写 stdout
  local label="$1" hint="$2"
  if _gum_interactive; then
    local tmp; tmp="$(mktemp)" || return 1
    if gum input --password --header "$label" --header.foreground 6 \
         --placeholder "$hint" < /dev/tty > "$tmp" 2>/dev/tty; then
      cat "$tmp"; rm -f "$tmp"; return 0
    fi
    rm -f "$tmp"; return 1
  fi
  local ans
  printf '  %s' "$(_cc_d "$label: ")" >&2
  IFS= read -rs ans || return 1
  printf '%s\n' "$ans"
}

# 安静版: 不渲染 gum header,label 由调用方通过 _ui_say 独立输出到 stderr
_ui_input_quiet() { # _ui_input_quiet <placeholder> [initial] -> 结果写 stdout
  local placeholder="$1" initial="${2:-}"
  if _gum_interactive; then
    local tmp; tmp="$(mktemp)" || return 1
    if gum input --placeholder "$placeholder" ${initial:+--value "$initial"} \
         < /dev/tty > "$tmp" 2>/dev/tty; then
      cat "$tmp"; rm -f "$tmp"; return 0
    fi
    rm -f "$tmp"; return 1
  fi
  local ans
  printf '  %s' "$(_cc_d "(回车保留 ${initial:-空}): ")" >&2
  IFS= read -r ans || return 1
  if [ -z "$ans" ]; then printf '%s\n' "$initial"; else printf '%s\n' "$ans"; fi
}

_ui_password_quiet() { # _ui_password_quiet <placeholder> -> 结果写 stdout
  local placeholder="$1"
  if _gum_interactive; then
    local tmp; tmp="$(mktemp)" || return 1
    if gum input --password --placeholder "$placeholder" \
         < /dev/tty > "$tmp" 2>/dev/tty; then
      cat "$tmp"; rm -f "$tmp"; return 0
    fi
    rm -f "$tmp"; return 1
  fi
  local ans
  printf '  %s' "$(_cc_d "输入: ")" >&2
  IFS= read -rs ans || return 1
  printf '%s\n' "$ans"
}

_ui_confirm() { # _ui_confirm <prompt> -> 0=确认 1=取消
  local prompt="$1"
  if _gum_interactive; then
    gum confirm "$prompt" < /dev/tty >/dev/tty 2>&1
    return $?
  fi
  local a
  printf '  %s [Y/n] ' "$prompt" >&2
  # 回退:读 y/n。注意 read 不加 `|| return 1` —— stdin 到达 EOF(非交互/headless,
  # 如 new 向导被管道喂入定量空行)时视为"确认",与旧 _ui_wizard_confirm 语义一致。
  # ⚠️ 共享原语:若未来给"破坏性操作"(如 rm)接入 _ui_confirm,EOF 默认确认是不安全的,
  # 那种调用方应显式要求肯定输入,不要依赖此默认。
  IFS= read -r a
  case "$a" in n|N|no|NO) return 1 ;; *) return 0 ;; esac
}

_ui_pick() { # _ui_pick <prompt>  (候选从 stdin 逐行) -> 选中项写 stdout
  local prompt="$1"
  local -a opts=(); local line
  while IFS= read -r line; do [ -n "$line" ] && opts+=("$line"); done
  [ "${#opts[@]}" -gt 0 ] || return 1
  if _gum_interactive; then
    printf '%s\n' "${opts[@]}" | gum filter --header "$prompt" --header.foreground 6 2>/dev/tty
    return $?
  fi
  local i
  printf '  %s\n' "$(_cc_bc "$prompt")" >&2
  for i in "${!opts[@]}"; do printf '    %d) %s\n' "$((i+1))" "${opts[$i]}" >&2; done
  printf '  选择编号: ' >&2
  # 优先从 /dev/tty 读(管道候选情况);无 tty 时把 stdin 最后一行当编号
  local n
  if { : < /dev/tty; } 2>/dev/null; then
    IFS= read -r n < /dev/tty || return 1
  else
    # 非交互测试环境:opts 最后一项即用户输入的编号
    n="${opts[$((${#opts[@]}-1))]}"
    opts=("${opts[@]:0:$((${#opts[@]}-1))}")
    [ "${#opts[@]}" -gt 0 ] || return 1
    # 重新打印实际候选(之前打印了含编号的列表,用 stderr 更新)
    printf '\r' >&2  # 视觉上无明显影响,无法回撤已输出行
  fi
  case "$n" in (*[!0-9]*|'') return 1 ;; esac
  [ "$n" -ge 1 ] && [ "$n" -le "${#opts[@]}" ] || return 1
  printf '%s\n' "${opts[$((n-1))]}"
}

_resolve_profile_arg() { # _resolve_profile_arg <usage_msg> [name] -> 选定名写 stdout
  local usage="$1" name="${2:-}"
  if [ -n "$name" ]; then printf '%s\n' "$name"; return 0; fi
  local -a names=(); local f
  for f in "$PROFILES_DIR"/*.env; do
    [ -e "$f" ] || continue
    names+=("$(basename "$f" .env)")
  done
  if [ "${#names[@]}" -gt 0 ] && _gum_interactive; then
    local picked
    picked="$(printf '%s\n' "${names[@]}" | _ui_pick "选择 profile")" || _die 2 "$usage"
    [ -n "$picked" ] || _die 2 "$usage"
    printf '%s\n' "$picked"; return 0
  fi
  _die 2 "$usage"
}

_ui_say() { # _ui_say <title|ok|err|warn|info|dim> <text>  -> stdout(单次 gum fork)
  local pal="$1"; shift; local text="$*"
  if _has_gum; then
    case "$pal" in
      title) gum style --bold --foreground 6 -- "$text" ;;
      ok)    gum style --foreground 2 -- "$text" ;;
      err)   gum style --foreground 1 -- "$text" ;;
      warn)  gum style --foreground 3 -- "$text" ;;
      info|dim) gum style --foreground 8 -- "$text" ;;
      *)     gum style -- "$text" ;;
    esac
    return
  fi
  if [ "$_cc_on" -eq 1 ]; then
    case "$pal" in
      title) printf '%s\n' "$(_cc_bc "$text")" ;;
      ok)    printf '%s\n' "$(_cc_g "$text")" ;;
      err)   printf '%s\n' "$(_cc_r "$text")" ;;
      warn)  printf '%s\n' "$(_cc_y "$text")" ;;
      info|dim) printf '%s\n' "$(_cc_d "$text")" ;;
      *)     printf '%s\n' "$text" ;;
    esac
    return
  fi
  printf '%s\n' "$text"
}

# ─── Environment variable reference and custom var addition ──────────

_resolve_env_ref() { # -> sets _ENV_REF to path of env_ref.txt
  # Priority: same dir as ccm > ~/.cc-manager > ~/.config/cc-manager
  local script_dir
  script_dir="$(cd "$(dirname "$0")" && pwd)"
  if [ -f "$script_dir/env_ref.txt" ]; then
    _ENV_REF="$script_dir/env_ref.txt"
  elif [ -f "$CCM_HOME/env_ref.txt" ]; then
    _ENV_REF="$CCM_HOME/env_ref.txt"
  else
    _ENV_REF=""
  fi
}

_search_env_ref() { # _search_env_ref <query> -> matching lines KEY|CAT|DESC to stdout
  local query="$1"
  [ -n "$_ENV_REF" ] && [ -f "$_ENV_REF" ] || return 1
  if [ -z "$query" ]; then
    grep -v '^#' "$_ENV_REF" | grep -v '^$'
  else
    grep -v '^#' "$_ENV_REF" | grep -v '^$' | grep -i -- "$query"
  fi
}

_add_custom_env_vars() { # _add_custom_env_vars <profile_file> <keys_array_name> <vals_array_name>
  _resolve_env_ref
  local pf="$1"
  local keys_ref="$2[@]" vals_ref="$3[@]"

  # Read existing into local arrays
  local -a ekeys=("${!keys_ref}")
  local -a evals=("${!vals_ref}")

  # _add_custom_env_vars_read sets _CUSTOM_KEYS/_CUSTOM_VALS globals
  _add_custom_env_vars_read "$pf" ekeys evals
  # Don't override — _read/_dialog already set _CUSTOM_KEYS/_CUSTOM_VALS
}

# Global return arrays for _add_custom_env_vars
_CUSTOM_KEYS=()
_CUSTOM_VALS=()

_add_custom_env_vars_read() { # _add_custom_env_vars_read <profile_file> keys_ref vals_ref
  local pf="$1"
  local keys_ref="$2[@]" vals_ref="$3[@]"
  local -a ekeys=("${!keys_ref}")
  local -a evals=("${!vals_ref}")

  # ── Phase 1: Review & edit existing custom vars ─────────────────────
  if [ "${#ekeys[@]}" -gt 0 ]; then
    printf '\n' >&2
    _ui_say title "━━━ 现有自定义环境变量 ━━━" >&2
    printf '\n' >&2
    local i=0
    while [ "$i" -lt "${#ekeys[@]}" ]; do
      local key="${ekeys[$i]}"
      local val="${evals[$i]}"
      _ui_say dim "  ${key} = $(_mask_preview "$val")" >&2
      i=$((i + 1))
    done
    printf '\n' >&2
    _ui_say dim "逐行编辑: 回车保留 | 输入新值覆盖 | --delete 删除" >&2
    printf '\n' >&2

    i=0
    while [ "$i" -lt "${#ekeys[@]}" ]; do
      local key="${ekeys[$i]}"
      local val="${evals[$i]}"
      local answer
      answer="$(_ui_input "编辑 $key" "回车保留, --delete 删除" "$val")" || { i=$((i + 1)); continue; }
      if [ "$answer" = "--delete" ] || [ "$answer" = "--del" ] || [ "$answer" = "--rm" ]; then
        _ui_say warn "✖ $key 已删除" >&2
        unset 'ekeys[$i]' 'evals[$i]'
      elif [ "$answer" != "$val" ]; then
        evals[$i]="$answer"
        _ui_say ok "✓ $key 已更新" >&2
      else
        _ui_say dim "· $key 保留原值" >&2
      fi
      i=$((i + 1))
    done

    # Compact arrays
    local -a compact_keys=() compact_vals=()
    for i in "${!ekeys[@]}"; do
      [ -n "${ekeys[$i]:-}" ] && { compact_keys+=("${ekeys[$i]}"); compact_vals+=("${evals[$i]}"); }
    done
    ekeys=("${compact_keys[@]}")
    evals=("${compact_vals[@]}")
    printf '\n' >&2
  fi

  # ── Phase 2: Add new custom vars ────────────────────────────────────
  if [ -n "$_ENV_REF" ] && _gum_interactive; then
    # ── Gum path: inline fuzzy filter + select + value ──────────────
    while true; do
      # Build candidate list (exclude already-added keys), format for filter
      local cand_list
      cand_list="$(
        while IFS='|' read -r k c d; do
          [ -z "$k" ] && continue
          local skip=0
          for ek in "${ekeys[@]}"; do
            [ "$ek" = "$k" ] && { skip=1; break; }
          done
          [ "$skip" -eq 1 ] && continue
          printf '%s  —  [%s] %s\n' "$k" "$c" "$d"
        done < <(_search_env_ref "")
      )"

      if [ -z "$cand_list" ]; then
        _ui_say dim "所有已知环境变量已添加" >&2
        printf '\n' >&2
        break
      fi

      printf '\n' >&2
      local picked
      picked="$(printf '%s\n' "$cand_list" | gum filter \
        --header "搜索环境变量 (ESC 完成, Ctrl+C 取消)" \
        --header.foreground 6 \
        --placeholder "输入关键词筛选..." \
        --height 8 --limit 1 \
        2>/dev/tty)" || break  # ESC → exit loop, Ctrl+C → cancel

      [ -n "$picked" ] || break

      # Extract key (first space-delimited token)
      local key="${picked%% *}"

      # Validate key format
      if ! printf '%s' "$key" | grep -qE '^[A-Z][A-Z0-9_]*$'; then
        _ui_say warn "无效选择: $key" >&2
        continue
      fi

      # Show description from env_ref
      local desc
      desc="$(grep "^${key}|" "$_ENV_REF" 2>/dev/null | head -1 | cut -d'|' -f3)"
      [ -n "$desc" ] && _ui_say dim "  $desc" >&2

      # Prompt for value using existing gum-enabled _ui_input
      local val
      val="$(_ui_input "$key" "输入值..." "")" || continue
      [ -n "$val" ] || { _ui_say dim "值为空，跳过" >&2; continue; }

      ekeys+=("$key")
      evals+=("$val")
      _ui_say ok "✓ $key 已添加" >&2
    done

  else
    # ── Fallback: plain text search + manual entry ──────────────────
    while true; do
      # Search
      if [ -n "$_ENV_REF" ]; then
        printf '\n  %s\n' "$(_cc_bc '━━━ 搜索/添加环境变量 ━━━')" >&2
        printf '  关键词%s: ' "$(_cc_d ' (留空显示全部)')" >&2
        local query
        read -r query
        if [ -n "$query" ]; then
          local results
          results="$(_search_env_ref "$query")"
          if [ -n "$results" ]; then
            printf '\n  %s\n' "$(_cc_d '搜索结果')" >&2
            while IFS='|' read -r fkey fcat fdesc; do
              printf '    %s  %s\n' "$(_cc_c "$fkey")" "$(_cc_d "$fdesc")" >&2
            done <<< "$results"
            printf '\n' >&2
          else
            printf '  %s 未找到匹配项\n\n' "$(_cc_r '✖')" >&2
          fi
        else
          printf '\n  %s (前 50 项)\n' "$(_cc_d '全部环境变量')" >&2
          local total_count
          total_count="$(_search_env_ref "" | wc -l | tr -d ' ')"
          _search_env_ref "" | head -50 | while IFS='|' read -r fkey fcat fdesc; do
            printf '    %s  %s\n' "$(_cc_c "$fkey")" "$(_cc_d "$fdesc")" >&2
          done
          printf '  %s\n\n' "$(_cc_d "... 共 $total_count 项, 输入关键词可缩小范围")" >&2
        fi
      fi

      printf '  ➕ 变量名%s: ' "$(_cc_d ' (留空结束)')" >&2
      local key
      read -r key
      [ -n "$key" ] || break

      # Validate
      if ! printf '%s' "$key" | grep -qE '^[A-Z][A-Z0-9_]*$'; then
        printf '  %s 无效的变量名: %s\n\n' "$(_cc_r '✖')" "$(_cc_r "$key")" >&2
        continue
      fi

      # Check if already exists
      local found=0
      for ek in "${ekeys[@]}"; do
        [ "$ek" = "$key" ] && { found=1; break; }
      done
      [ "$found" -eq 1 ] && { printf '  %s 变量 %s 已存在\n\n' "$(_cc_r '✖')" "$(_cc_r "$key")" >&2; continue; }

      # Get description
      if [ -n "$_ENV_REF" ]; then
        local desc
        desc="$(grep "^${key}|" "$_ENV_REF" 2>/dev/null | head -1 | cut -d'|' -f3)"
        [ -n "$desc" ] && printf '  %s %s\n' "$(_cc_d '└─')" "$(_cc_d "$desc")" >&2
      fi

      printf '  💎 %s 值: ' "$(_cc_c "$key")" >&2
      local val
      read -r val
      [ -n "$val" ] || { printf '  %s 值为空，跳过\n\n' "$(_cc_d '·')" >&2; continue; }

      ekeys+=("$key")
      evals+=("$val")
      printf '  %s 已添加\n' "$(_cc_g '✓')" >&2
    done
  fi

  # Return via globals
  _CUSTOM_KEYS=("${ekeys[@]}")
  _CUSTOM_VALS=("${evals[@]}")
}


cmd_list() {
  _ensure_skeleton
  local found=0 f name url line
  local -a rows=()
  for f in "$PROFILES_DIR"/*.env; do
    [ -e "$f" ] || continue
    found=1
    name="$(basename "$f" .env)"
    line="$(grep -E '^[[:space:]]*export[[:space:]]+ANTHROPIC_BASE_URL=' "$f" | head -1)"
    url="${line#*=}"; url="${url%\"}"; url="${url#\"}"; url="${url%\'}"; url="${url#\'}"
    rows+=("$(printf '%-20s %s' "$name" "${url:-(no base_url)}")")
  done
  if [ "$found" -ne 1 ]; then
    _ui_say dim "(暂无 profile,用 'ccm new <name>' 创建)"
    return
  fi
  if _has_gum; then
    printf '%s\n' "${rows[@]}" | gum style --foreground 7
  else
    printf '%s\n' "${rows[@]}"
  fi
}

cmd_new() {
  local name="$1"
  [ -n "$name" ] || _die 2 "用法: ccm new <profile>"
  _ensure_skeleton
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] && _die 1 "profile '$name' 已存在(用 'ccm edit $name')"

  if _interactive_profile "new" "$name"; then
    _ui_say ok "✓ 已创建 $pf"
  else
    rm -f "$pf"
    _ui_say err "✖ 已取消" >&2
    exit 1
  fi
}

cmd_edit() {
  local name; name="$(_resolve_profile_arg "用法: ccm edit <profile>" "$1")" || exit $?
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在(用 'ccm new $name')"

  # Backup current file before editing
  _rotate_backups "$pf"

  if _interactive_profile "edit" "$name" "$pf"; then
    _ui_say ok "✓ 已更新 $pf"
    # Show backup hint if backups exist
    if [ -f "${pf}.back.1" ]; then
      _ui_say info "💡 使用 ccm backup-list $name 查看备份记录"
    fi
  else
    _ui_say err "✖ 已取消，未保存更改" >&2
    exit 1
  fi
}

cmd_show() {
  local name="" raw=0 a
  for a in "$@"; do
    case "$a" in
      --raw) raw=1 ;;
      -*) _die 2 "未知选项: $a" ;;
      *) [ -z "$name" ] && name="$a" || _die 2 "多余参数: $a" ;;
    esac
  done
  [ -n "$name" ] || name="$(_resolve_profile_arg "用法: ccm show <profile> [--raw]")" || exit $?
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在"
  if [ "$raw" -eq 1 ]; then
    cat "$pf"
    return
  fi
  # 打码显示: token 掩码,其余原样
  local line val k v rendered
  rendered="$(
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      *ANTHROPIC_AUTH_TOKEN=*)
        val="${line#*=}"
        val="${val%\"}"; val="${val#\"}"
        val="${val%\'}"; val="${val#\'}"
        printf '  %s %s="%s"\n' "$(_cc_g '●')" "$(_cc_c 'ANTHROPIC_AUTH_TOKEN')" "$(_mask "$val")"
        ;;
      *export\ ANTHROPIC_BASE_URL=*)
        val="${line#*=}"
        val="${val%\"}"; val="${val#\"}"
        val="${val%\'}"; val="${val#\'}"
        printf '  %s %s=%s\n' "$(_cc_g '●')" "$(_cc_c 'ANTHROPIC_BASE_URL')" "$(_cc_y "$val")"
        ;;
      *export\ ANTHROPIC_DEFAULT_*|*export\ CLAUDE_CODE_SUBAGENT_MODEL*)
        # Standard model vars: show key + colored value
        k="$(printf '%s' "$line" | sed -n 's/^[[:space:]]*export[[:space:]]*\([A-Z_][A-Z0-9_]*\)=.*/\1/p')"
        v="$(printf '%s' "$line" | sed -n "s/^[[:space:]]*export[[:space:]]*[A-Z_][A-Z0-9_]*=[\"']\{0,1\}\([^\"'#]*\)[\"']\{0,1\}$/\1/p")"
        if [ -n "$k" ] && [ -n "$v" ]; then
          printf '  %s %s=%s\n' "$(_cc_g '●')" "$(_cc_c "$k")" "$(_cc_y "$v")"
        else
          printf '  %s\n' "$(_cc_d "$line")"
        fi
        ;;
      *export\ *CLAUDE_CODE_*|*export\ *BASH_*|*export\ *API_*|*export\ *MCP_*|*export\ *DEBUG*|*export\ *DISABLE_*|*export\ *ENABLE_*|*export\ *MAX_*|*export\ *HTTP_*|*export\ *NO_*)
        # Custom env vars: show key + yellow value
        k="$(printf '%s' "$line" | sed -n 's/^[[:space:]]*export[[:space:]]*\([A-Z_][A-Z0-9_]*\)=.*/\1/p')"
        v="$(printf '%s' "$line" | sed -n "s/^[[:space:]]*export[[:space:]]*[A-Z_][A-Z0-9_]*=[\"']\{0,1\}\([^\"'#]*\)[\"']\{0,1\}$/\1/p")"
        if [ -n "$k" ] && [ -n "$v" ]; then
          printf '  %s %s=%s\n' "$(_cc_y '◆')" "$(_cc_c "$k")" "$(_cc_y "$v")"
        else
          printf '  %s\n' "$(_cc_d "$line")"
        fi
        ;;
      *"# 自定义环境变量"*)
        printf '\n  %s\n' "$(_cc_br '━━━ 自定义环境变量 ━━━')"
        ;;
      *"# 模型映射"*|*"# 可选:子代理模型"*)
        printf '  %s\n' "$(_cc_d "$line")"
        ;;
      *"# cc-manager profile"*)
        printf '\n  %s\n' "$(_cc_bc "━━━ profile: $name ━━━")"
        ;;
      *'#'*) printf '  %s\n' "$(_cc_d "$line")" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done <"$pf"
  )"
  if _has_gum; then
    printf '%s\n' "$rendered" | gum style --foreground 7
  else
    printf '%s\n' "$rendered"
  fi
}

cmd_env() {
  local name="$1"
  [ -n "$name" ] || _die 2 "用法: ccm env <profile>"
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在"
  printf '%s\n' "$pf"
}

cmd_envref() {
  _resolve_env_ref
  if [ -z "$_ENV_REF" ] || [ ! -f "$_ENV_REF" ]; then
    _die 1 "未找到 env_ref.txt(请确认已安装 ccm 完整代码)"
  fi

  local query="" a
  for a in "$@"; do
    case "$a" in
      -*) _die 2 "未知选项: $a" ;;
      *) query="$query $a" ;;
    esac
  done
  query="${query# }"  # strip leading space

  if [ -n "$query" ]; then
    printf '搜索: %s\n\n' "$query"
    _search_env_ref "$query" | while IFS='|' read -r key cat desc; do
      printf '  %-45s %-10s %s\n' "$key" "$cat" "$desc"
    done
    local count
    count="$(_search_env_ref "$query" | wc -l)"
    printf '\n共 %d 项\n' "$count"
  else
    printf '用法: ccm envref [关键词...]\n\n'
    printf '示例:\n'
    printf '  ccm envref timeout          搜索含 timeout 的变量\n'
    printf '  ccm envref tui              搜索 TUI 相关变量\n'
    printf '  ccm envref CLAUDE_CODE_NO   搜索特定前缀\n'
    printf '  ccm envref                  显示全部 (%d 项)\n\n' "$(_search_env_ref "" | wc -l)"
    # Show categorized summary
    printf '分类统计:\n'
    _search_env_ref "" | cut -d'|' -f2 | sort | uniq -c | sort -rn | while read -r n cat; do
      printf '  %-12s %d\n' "$cat" "$n"
    done
  fi
}

cmd_rm() {
  local name; name="$(_resolve_profile_arg "用法: ccm rm <profile>" "$1")" || exit $?
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在"
  printf "%s确认删除 profile '%s'? [y/N] " "$(_cc_r '⚠ ')" "$name"
  local ans; read -r ans
  case "$ans" in
    y|Y|yes|YES) rm -f "$pf"; _ui_say ok "✓ 已删除 $name" ;;
    *) echo "已取消" ;;
  esac
}

cmd_backup_list() {
  local name="$1"
  [ -n "$name" ] || _die 2 "用法: ccm backup-list <profile>"
  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在"

  printf '\n'
  _ui_say title "━━━ profile: $name 的备份 ━━━"
  printf '\n'

  if _list_backups "$pf" "$name"; then
    printf '\n'
    _ui_say info "💡 回滚: ccm backup-restore $name <序号>"
    printf '\n'
  else
    _ui_say dim "(暂无备份)"
    printf '\n'
  fi
}

cmd_backup_restore() {
  local n="$2"
  [ -n "$n" ] || _die 2 "用法: ccm backup-restore <profile> <N>"
  local name; name="$(_resolve_profile_arg "用法: ccm backup-restore <profile> <N>" "$1")" || exit $?

  # Validate N is a number
  case "$n" in
    ''|*[!0-9]*) _die 2 "备份序号必须是数字: '$n'" ;;
  esac
  [ "$n" -ge 1 ] && [ "$n" -le "$_BACKUP_MAX" ] || _die 2 "备份序号必须在 1~${_BACKUP_MAX} 之间"

  local pf; pf="$(_profile_path "$name")" || exit $?
  [ -f "$pf" ] || _die 1 "profile '$name' 不存在"

  # Confirm before restoring
  printf '%s 确认回滚 profile %s 到 back.%s? [y/N] ' "$(_cc_r '⚠ ')" "$(_cc_c "$name")" "$n"
  local ans; read -r ans
  case "$ans" in
    y|Y|yes|YES) ;;
    *) echo "已取消"; exit 0 ;;
  esac

  _restore_backup "$pf" "$n"

  _ui_say ok "✓ 已回滚 $pf 到 back.$n"
  _ui_say info "💡 当前版本已保存为 back.1"
  _ui_say info "💡 使用 ccm backup-list $name 查看备份记录"
}

usage_run() {
  echo "用法: ccm run <profile> [--opus M] [--sonnet M] [--haiku M] [--subagent M] [-- <claude args>]" >&2
}

cmd_run() {
  local profile="" opus="" sonnet="" haiku="" subagent=""
  local passthrough=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --opus)     [ $# -ge 2 ] && [ "${2#-}" = "$2" ] || _die 2 "$1 需要一个模型参数"; opus="$2";     shift 2 ;;
      --sonnet)   [ $# -ge 2 ] && [ "${2#-}" = "$2" ] || _die 2 "$1 需要一个模型参数"; sonnet="$2";   shift 2 ;;
      --haiku)    [ $# -ge 2 ] && [ "${2#-}" = "$2" ] || _die 2 "$1 需要一个模型参数"; haiku="$2";    shift 2 ;;
      --subagent) [ $# -ge 2 ] && [ "${2#-}" = "$2" ] || _die 2 "$1 需要一个模型参数"; subagent="$2"; shift 2 ;;
      --) shift; passthrough=("$@"); break ;;
      -*) usage_run; exit 2 ;;
      *)  if [ -z "$profile" ]; then profile="$1"; shift; else _die 2 "多余参数: $1"; fi ;;
    esac
  done

  if [ -z "$profile" ]; then
    profile="$(_resolve_profile_arg "$(usage_run 2>&1)")" || exit $?
  fi

  local pf; pf="$(_profile_path "$profile")" || exit $?
  if [ ! -f "$pf" ]; then
    echo "cc-manager: profile '$profile' 不存在,可用:" >&2
    cmd_list >&2
    exit 1
  fi

  set -a
  # shellcheck disable=SC1090
  . "$pf"
  set +a

  if [ -n "$opus" ];     then export ANTHROPIC_DEFAULT_OPUS_MODEL="$opus";     export ANTHROPIC_DEFAULT_OPUS_MODEL_NAME="$opus"; fi
  if [ -n "$sonnet" ];   then export ANTHROPIC_DEFAULT_SONNET_MODEL="$sonnet"; export ANTHROPIC_DEFAULT_SONNET_MODEL_NAME="$sonnet"; fi
  if [ -n "$haiku" ];    then export ANTHROPIC_DEFAULT_HAIKU_MODEL="$haiku";   export ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME="$haiku"; fi
  if [ -n "$subagent" ]; then export CLAUDE_CODE_SUBAGENT_MODEL="$subagent"; fi

  [ -n "$ANTHROPIC_AUTH_TOKEN" ] || echo "cc-manager: 警告 — ANTHROPIC_AUTH_TOKEN 为空" >&2
  [ -n "$ANTHROPIC_BASE_URL" ]   || echo "cc-manager: 警告 — ANTHROPIC_BASE_URL 为空" >&2

  # 检查 settings.json 中是否有 env.ANTHROPIC_* 会覆盖 profile 环境变量
  local project_settings="$PWD/.claude/settings.json"
  local user_settings="$HOME/.claude/settings.json"
  local found_conflict=0
  for sf in "$project_settings" "$user_settings"; do
    local result
    result="$(_check_settings_anthropic "$sf")"
    if [ -n "$result" ]; then
      if [ "$found_conflict" -eq 0 ]; then
        echo "" >&2
        echo "cc-manager: 警告 — 检测到以下 settings.json 中的 env.ANTHROPIC_* 配置将覆盖当前 profile 环境变量:" >&2
        found_conflict=1
      fi
      if [ "$sf" = "$project_settings" ]; then
        echo "  [项目] $sf" >&2
      else
        echo "  [用户] $sf" >&2
      fi
      echo "$result" >&2
    fi
  done
  if [ "$found_conflict" -eq 1 ]; then
    echo "  → profile 的对应变量可能不生效" >&2
    sleep 1
  fi

  command -v claude >/dev/null 2>&1 || _die 127 "未找到 'claude' 命令(请确认已安装并在 PATH 中)"

  exec claude "${passthrough[@]}"
}

usage() {
  cat <<'EOF'
cc-manager (ccm) — 管理多个 Claude Code 环境

用法:
  ccm run <profile> [--opus M] [--sonnet M] [--haiku M] [--subagent M] [-- <claude args>]
  ccm list | ls
  ccm new <profile>
  ccm edit <profile>
  ccm show <profile> [--raw]
  ccm rm <profile>
  ccm backup-list <profile>            # 查看备份
  ccm backup-restore <profile> <N>     # 回滚到指定备份
  ccm env <profile>
  ccm envref [关键词...]
  ccm help | -h | --help
  ccm version | --version
EOF
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    version|--version) echo "ccm $CCM_VERSION" ;;
    list|ls) cmd_list ;;
    new) cmd_new "$@" ;;
    edit) cmd_edit "$@" ;;
    show) cmd_show "$@" ;;
    rm) cmd_rm "$@" ;;
    backup-list) cmd_backup_list "$@" ;;
    backup-restore) cmd_backup_restore "$@" ;;
    env) cmd_env "$@" ;;
    envref) cmd_envref "$@" ;;
    run) cmd_run "$@" ;;
    *) _die 2 "未知命令: $cmd(运行 'ccm help')" ;;
  esac
}

[ -n "${CCM_SOURCED:-}" ] || main "$@"
